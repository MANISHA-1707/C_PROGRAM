#include <stdio.h>
int main()
{
   int arr[100],i,n,count,search;
   printf("Enter the Size of Array: ");
   scanf("%d",&n);
   printf("Enter the Elements: ");
   for(i=0;i<n;i++)
   {
      scanf("%d",&arr[i]);
   }
   printf("Enter the element to be searched: ");
   scanf("%d",&search);
   for(i=0;i<n;i++)
   {
      if(arr[i]==search)
      {
         printf("Position of Element: %d\n",i+1);
         count++;
      }
   }
   printf("Count = %d\n",count);
}
