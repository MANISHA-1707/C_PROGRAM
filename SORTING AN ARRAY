#include <stdio.h>
int main()
{
   int a,i,n,j=0;
   int arr[100];
   printf("Enter the size of Array: ");
   scanf("%d",&n);
   printf("Enter the Elements of Array: ");
   for(i=0;i<n;i++)
   {
      scanf("%d",&arr[i]);
   }
   for(i=0;i<n;i++)
   {
      for(j=i+1;j<n;j++)
      {
         if (arr[i] > arr[j])
         {
            a = arr[i];
            arr[i] = arr[j];
            arr[j] = a;

         }
      }
   }
   printf("SORTED ARRAY\n");
   for(i=0;i<n;i++)
   {
      printf("%d\t",arr[i]);
   }
   printf("\n");
}
