#include <stdio.h>
#include <string.h>
int main()
{
   char a[100],b[100];
   int c = 0,i,j=0;
   printf("Enter a String: ");
   scanf("%[^\n]",&a);
   printf("Enter the Substring: ");
   scanf("%s",&b);
   for(i=0;a[i]!='\0';i++)
   {
      if (a[i]==b[i])
      {
         j++;
      }
      else if (a[i]==b[0])
      {
         j=1;
      }
      else
      {
         j=0;
      }
      if(b[j]=='\0')
      {
         c++;
         j=0;
      }
   }
   printf("Number of Occurences: %d",c);
}
