#include <stdio.h>
int prime(int);
int main()
{
   int r,i,n;
   printf("Enter a Number: ");
   scanf("%d",&n);
   for (i=1;i<=n;i++)
   {
      r = prime(i);
      if (r==1)
      {
         printf("%d\t",i);
      }
   }
}
int prime(n)
{
   int i,count=0;
   for (i=1;i<=n;i++)
   {
      if (n%i == 0)
      {
         count = count+1;
      }
   }
   if (count==2)
   {
      return 1;
   }
   else
   {
      return 0;
   }
}
