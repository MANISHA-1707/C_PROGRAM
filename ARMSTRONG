#include <stdio.h>
int main()
{
   int num,originalnum,remainder,result = 0;
   printf("Enter a Number: ");
   scanf("%d",&num);
   originalnum=num;
   for (;originalnum!=0;)
   {
      remainder = originalnum%10;
      result += remainder*remainder*remainder;
      originalnum /= 10;
   }
   if (result == num)
      printf("Number %d is a Armstrong Number.",num);
   else
      printf("Number %d is not a Armstrong Number.",num);
}
