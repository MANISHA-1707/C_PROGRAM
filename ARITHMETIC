#include <stdio.h>
void main()
{
   float a,b,c;
   char ch;
   printf("Enter the choice: ");
   scanf("%c",&ch);
   printf("Enter the numbers: ");
   scanf("%f %f",&a,&b);
   switch(ch)
   {
      case'+':
         c = a+b;
         printf("Sum = %f",c);
         break;
      case'-':
         c = a-b;
         printf("Difference = %f",c);
         break;
      case'*':
         c = a*b;
         printf("Product = %f",c);
         break;
      case'/':
         c = a/b;
         printf("Quotient = %f",c);
         break;
      default:
         printf("No Operation");
         break;
   }
}
