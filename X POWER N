#include <stdio.h>
int power(int,int);
int main()
{
   int n,x,a;
   printf("Enter base value: ");
   scanf("%d",&x);
   printf("Enter exponent value: ");
   scanf("%d",&n);
   a = power(x,n);
   printf("Value of x power n: %d\n",a);
}
int power(int x,int n)
{
   if (n==0)
   {
      return 1;
   }
   else if (n==1)
   {
      return x;
   }
   else if (n>1)
   {
      int p = x*(power(x,n-1));
      return p;
   }
}
